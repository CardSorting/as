APP_NAME=GumroadClone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Store Domain Configuration
STORE_BASE_DOMAIN=gumroad-clone.test
SSL_WILDCARD_CERT=/etc/ssl/certs/wildcard.gumroad-clone.test.pem
SSL_WILDCARD_KEY=/etc/ssl/private/wildcard.gumroad-clone.test.key

# DNS Provider Configuration
DNS_PROVIDER=cloudflare
DNS_ZONE_ID=your_zone_id
DNS_API_TOKEN=your_api_token

# Store Queue Configuration
QUEUE_STORE_BASIC_WORKERS=1
QUEUE_STORE_PRO_WORKERS=2
QUEUE_STORE_ENTERPRISE_WORKERS=4
